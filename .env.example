# ========================================================
# KateringKita Backend - Environment Variables
# Disalin ke .env lalu diisi. Server menolak start bila nilai wajib kosong/tidak valid.
# ========================================================

NODE_ENV=development
PORT=5000

# Wajib. Lokal (Docker MySQL): mysql://root:root@127.0.0.1:3306/kateringkita
# TiDB Cloud: mysql://<user>:<password>@<host>:4000/<db>  (SSL otomatis)
DATABASE_URL=

# Dipakai test yang butuh database (DB khusus test, akan dikosongkan saat test)
TEST_DATABASE_URL=

# Wajib, minimal 32 karakter acak. Buat dengan:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Opsional. Rahasia bersama dengan server dashboard web (isi sama di fe/.env.local, minimal 32 karakter)
# agar batas percobaan masuk dihitung per alamat pengunjung. Buat dengan perintah yang sama seperti JWT_SECRET.
INTERNAL_API_SECRET=
JWT_TTL_WEB=1d
JWT_TTL_MOBILE=30d

# Daftar origin web yang diizinkan, dipisah koma. Wajib di production.
CORS_ORIGIN=http://localhost:3000

TZ=Asia/Jakarta

# Opsional. Cloudflare R2 untuk unggah foto menu/logo/QRIS/avatar. Isi SEMUA atau kosongkan SEMUA
# (kosong = endpoint unggah menjawab 503). Rahasia ini hanya untuk backend, jangan disalin ke fe/.
# Aturan CORS bucket R2: izinkan metode PUT dari origin web (CORS_ORIGIN) dengan header content-type.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# URL publik bucket (https://, tanpa garis miring akhir), mis. domain r2.dev atau domain kustom
R2_PUBLIC_URL=

# Opsional, hanya saat menjalankan skrip (jangan disimpan permanen):
# sandi awal untuk npm run admin:create
# ADMIN_INITIAL_PASSWORD=
# sandi akun penjual demo untuk npm run seed:demo (DB lokal saja)
# DEMO_PASSWORD=

# Opsional. SMTP untuk kode OTP lupa sandi (F11). Isi SEMUA atau kosongkan SEMUA.
# Kosong: di development/test kode ditulis ke log server; di production endpoint menjawab 503.
# Contoh Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=alamat@gmail.com, SMTP_PASS=<app password 16 huruf>
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Opsional. Google Gemini untuk Asisten AI toko (F17). Kosong: POST /merchant/assistant menjawab 503.
# Kunci dari Google AI Studio; hanya untuk backend, jangan disalin ke fe/ atau aplikasi mobile.
GEMINI_API_KEY=
# Bawaan gemini-2.5-flash
GEMINI_MODEL=

# Opsional. Midtrans untuk pembayaran Virtual Account (F10). Kosong: checkout VA menjawab 409.
# Server Key dari Settings → Access Keys (bukan Client Key). Hanya untuk backend.
# Notification URL di dashboard Midtrans: <URL backend>/api/v1/payments/midtrans
MIDTRANS_SERVER_KEY=
# Signature Secret Key (Settings → Access Keys → General Credentials) untuk memverifikasi notifikasi.
# Wajib bila Server Key dibuat ulang/baru: sejak 28 Okt 2026 notifikasi tidak lagi ditandatangani Server Key. Kosong = pakai Server Key.
MIDTRANS_SIGNATURE_KEY=
# true = transaksi sungguhan di api.midtrans.com; bawaan false (sandbox)
MIDTRANS_IS_PRODUCTION=
