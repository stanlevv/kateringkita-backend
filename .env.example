# ========================================================
# KateringKita Backend - Environment Variables Configuration
# ========================================================

# Server Port
PORT=5000
NODE_ENV=development

# --------------------------------------------------------
# Database Configuration (MySQL / MariaDB / TiDB Cloud)
# --------------------------------------------------------
# Opsi 1: Konfigurasi Terpisah (Default Lokal / Laragon / XAMPP)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=kateringkita_db
DB_SSL=false

# Opsi 2: Konfigurasi Single URI Connection String (TiDB Cloud / Heroku)
# DATABASE_URL=mysql://<user>:<password>@<host>:4000/test?ssl={"rejectUnauthorized":true}

# --------------------------------------------------------
# Keamanan & Autentikasi (JWT)
# --------------------------------------------------------
JWT_SECRET=kateringkita_jwt_secret_key_2026_uas
JWT_EXPIRES_IN=24h

# --------------------------------------------------------
# CORS Configuration
# --------------------------------------------------------
CORS_ORIGIN=*
